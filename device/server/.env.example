# このファイルを .env にコピーして値を埋める（.env は .gitignore 済み）。
#
#   cp .env.example .env

# 動作モード。
#
#   stub  AI を呼ばず固定の応答を返す。UI と音声の検証用
#   live  本物の AI を呼ぶ。**課金が発生する**
#
# 既定は stub。うっかり課金する事故を防ぐため、live は明示したときだけ。
AICHAT_MODE=stub

# --- 鍵 ---
#
# 値を直接書く形と、OS の鍵束から読む形の両方を受ける。
#
#   ANTHROPIC_API_KEY=sk-ant-...                                直接書く
#   ANTHROPIC_API_KEY=keychain:aichat-device/ANTHROPIC_API_KEY  鍵束から読む
#
# 鍵束への登録:
#   macOS  security add-generic-password -s aichat-device -a ANTHROPIC_API_KEY -w '値'
#   Linux  secret-tool store --label=ANTHROPIC_API_KEY service aichat-device account ANTHROPIC_API_KEY
#
# **鍵束は万能ではない。** このデバイスは人が居なくても起動して喋れる
# 必要があるので、復号のための秘密もデバイス上にある。機械ごと持って
# 行かれれば同じことで、守れるのは「うっかり commit する」「バックアップに
# 写る」「同じ機械の別プロセスが読む」あたりまで。
#
# 効き目が確かなのは鍵の被害額を絞ること。Anthropic の Workspace ごとに
# 月次の上限を付けた API キーを使えば、漏れても上限で止まる。

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 音声認識に OpenAI を選んだときだけ要る（既定のローカル whisper なら不要）。
OPENAI_API_KEY=

# --- 管理UI ---
#
# ADMIN_PASSWORD が空なら **管理画面に鍵をかけない**（意図した動作）。
#
# このサーバーは 127.0.0.1 でしか待ち受けず、外から届かない。さらに
# /api/chat は元から無認証なので、LAN へ開くならパスワードの有無に
# 関わらず AI を呼ばれる。**防御線は待ち受けアドレスであって、
# 管理画面のパスワードではない。**
#
# HOST を 127.0.0.1 から変えるなら、必ずここも設定すること。
# 値はランダムでよい: openssl rand -base64 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- 待ち受け ---
#
# 127.0.0.1 から変えないこと。/api/* は認証を持たないので、
# LAN に開くと同じネットワークの誰でも AI を呼べる（課金はこちら持ち）。
# ついでに getUserMedia の secure context の条件も満たす。
#
# 別の機械から管理UI を開きたいときは SSH のポート転送を使う（転送先はこの Mac）:
#   ssh -L 9800:127.0.0.1:9800 <ユーザー>@<サーバーの Mac>.local
HOST=127.0.0.1
PORT=9801

# --- 音声認識 ---
#
# 既定は macOS の音声認識（SpeechAnalyzer）。実測で一番速く（0.14秒）、
# 音声が家の外に出ず、課金も無い。`ohr` が OpenAI 互換のサーバーとして包む。
#
#   brew tap Arthur-Ficial/tap && brew install ohr
#   ohr --serve --port 8091 --host 127.0.0.1
#
# **既定のポート 11434 は Ollama と衝突する。** 8091 で立てること。
# macOS 26 以降の Apple Silicon が要る。**サーバーを Mac に据え置くのはこれが理由**
# なので、通常はこのまま使う（docs/04 の「変更の記録」）。
APPLE_SPEECH_URL=http://127.0.0.1:8091

# ローカルの whisper.cpp（whisper-server）の URL。
# 上の方が 5 倍速いので、**サーバーを Mac 以外へ動かすときの逃げ道**。
#
#   brew install whisper-cpp
#   curl -L -o ~/.cache/whisper-models/ggml-large-v3-turbo-q5_0.bin \
#     https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo-q5_0.bin
#   whisper-server -m ~/.cache/whisper-models/ggml-large-v3-turbo-q5_0.bin \
#     -l ja --host 127.0.0.1 --port 8090 -t 8 -ac 512
#
# `-ac 512` は音声文脈の縮小。whisper は入力を 30 秒窓に詰めて処理するので、
# 短い問いかけでも固定費がかかる。窓を縮めると 3 倍速くなる（2.4秒 → 0.74秒）。
WHISPER_URL=http://127.0.0.1:8090

# --- 読み上げ ---
#
# VOICEVOX Engine の URL。空なら /api/tts は使えない。
#   docker run --rm -p 50021:50021 voicevox/voicevox_engine:cpu-arm64-latest
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=3

# --- 家の情報 ---
#
# 家の消費電力を測っているサーバー（house_power）の URL。
# スマートメーターから Wi-SUN Bルートで 5 秒ごとに瞬時電力を取っている、
# 別のローカルサーバー。**このサーバーは値を読むだけ**で、
# メーターとは直接話さない。
#
#   https://github.com/cathandnya/house_power
#
# 空なら電力の道具を AI に持たせない（宣言だけして失敗すると、
# 「調べます」と言ってから黙る挙動になるため）。
#
#   HOUSE_POWER_URL=http://<house_power の機械>:8000
HOUSE_POWER_URL=

# 製氷機タンクの水位センサー（water-level）の URL。
# 冷蔵庫の中の ESP32-C3 が、非接触センサーで水の有無だけを持っている。
# **分かるのは有無だけ**で、残りの量は取れない。
#
#   https://github.com/cathandnya/water-level
#
# **`.local` は書かないこと。** センサー自身は 40ms で返るが、Node から
# mDNS を引くと 1 回 5 秒かかる（実測）。声の返事には遅すぎるので IP で書く。
# IP はシリアルログか /api/status の "ip" で分かる。
#
#   WATER_LEVEL_URL=http://192.168.1.43
WATER_LEVEL_URL=

# PC の電源を操る装置（pc_power / Front Panel Bridge）の URL。
# マザーボードのフロントパネルピンを Raspberry Pi Zero W で無線化したもの。
#
#   https://github.com/cathandnya/pc_power
#
# **叩くのは /power/toggle だけ**にしてある（0.5 秒＝ボタンを
# ちょんと押すのと同じ。OS が受け取って通常どおり終了する）。
# /power/off は電源ピンを 5 秒押す＝OS に断たずに切るので、
# /reset ともども声からは届かないようにしている。
#
#   PC_POWER_URL=http://elise-info.local:8080
PC_POWER_URL=

# --- 検証を楽にするための設定（本番では触らない） ---

# stub のとき、受け取った音声を tmp/ に .wav で保存する。
# 保存したものを afinfo / QuickTime で確かめれば、
# 「16kHz mono 16bit になっているか」「語頭が切れていないか」が
# 上流を一度も呼ばずに分かる。
STUB_SAVE_AUDIO=0

# stub のとき、書き起こしとして返す固定の文字列。
STUB_TRANSCRIPT=明日の天気を教えて
