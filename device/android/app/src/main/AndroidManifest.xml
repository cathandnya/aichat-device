<?xml version="1.0" encoding="utf-8"?>
<!--
  据え置きの音声デバイス。**画面は顔と状態だけ、文字は出さない。**

  判断はすべて Mac のサーバーが持つ（ウェイクワードの判定・音声認識・
  AI・読み上げ）。このアプリは「マイクを送る・音を鳴らす・顔を出す」だけ。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 電源が入ったら勝手に立ち上がる（キオスク運用）。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <!--
      サーバーは家の LAN にしか出ない。証明書を配って回るより、
      平文の ws:// をそのまま通すほうが運用が軽い。
    -->
    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="nosensor"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- ランチャーとしても登録しておくと、ホームに戻っても顔が出る。 -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
