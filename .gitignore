# --- Secrets (never commit) ---
device/server/.env
# 控え（.env.bak-voicevox など）にも鍵がそのまま入る。**完全一致では
# 素通しになる**ので、接尾辞の付いたものもまとめて外す。
device/server/.env.*
!device/server/.env.example

# --- Node ---
node_modules/
dist/
*.log

# --- 保存されるもの ---
# 設定とモデル一覧。機械ごとの状態なので追跡しない。
device/server/data/
# STUB_SAVE_AUDIO=1 で保存した録音。中身は家族の声。
device/server/tmp/

# --- Android（device/android）---
device/android/.gradle/
device/android/build/
device/android/app/build/
# SDK の場所は機械ごと。追跡しない。
device/android/local.properties
# 立ち絵。web と同じく git に入れない。
# **assets に置く。** drawable だと R.drawable.* がコンパイル時に要るので、
# 画像が無いとビルドごと通らなくなる（clone しただけの人が困る）。
device/android/app/src/main/assets/character/*.png
# 素材の元ファイル。
device/android/zundamon/

# --- macOS ---
.DS_Store

# --- 立ち絵・音 ---
# ずんだもんの素材。**配布元の規約（再配布の可否）を確かめていないので追跡しない。**
# 置き方は device/web/public/character/README.md
device/web/public/character/*.png
# ウェイクワードに気づいたときの音。同じ理由で追跡しない。
device/web/public/wake.mp3
device/android/app/src/main/assets/wake.mp3
# 動画用のデモ音声。VOICEVOX で作った合成音なので追跡しない。
# 台本は demo/gen.sh にあるので、走らせれば作り直せる。
demo/*.wav
# 一覧は gen.sh が台本から吐く生成物。追跡しない。
demo/commands.json

echo

# 実機を追うときの出力先。追跡しない。
device/server/server.log

# NDK のビルド生成物。**中身は成果物なので追わない。**
device/android/app/.cxx/
